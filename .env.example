# ==============================================================================
# Monarch Brew - Environment Configuration
# ==============================================================================

# Site Mode: "demo" (default) or "live"
# - demo: Blocks search engine indexing (noindex, nofollow, disallow all in robots.txt),
#         omits sitemap.xml, and omits schema.org JSON-LD to prevent sample business data from being indexed.
# - live: Standard search indexing, sitemap generation, and business JSON-LD structured data.
NEXT_PUBLIC_SITE_MODE=demo

# Production Site URL (Used for sitemaps, robots.txt, Open Graph meta tags, and canonical links)
# Do not add a trailing slash.
SITE_URL=https://monarchbrew.in
NEXT_PUBLIC_SITE_URL=https://monarchbrew.in
